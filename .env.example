# GMGN Trading Agent — Environment Configuration
# Copy this file to ~/.config/gmgn/.env and fill in your credentials

# REQUIRED — Get your API Key from https://gmgn.ai
GMGN_API_KEY=your_gmgn_api_key_here

# REQUIRED for trading (swap, create token) — wallet bound to your API Key
# This is the PRIVATE KEY — never share it, never commit it
GMGN_PRIVATE_KEY=your_wallet_private_key_here

# OPTIONAL — Set to 1 to allow headless automated trades (no terminal prompt)
# Only enable if you understand the risks
GMGN_ALLOW_AUTOMATED_TRADES=0

# REQUIRED for PONS Token Factory — Robinhood ETH RPC URL
ROBINHOOD_RPC=https://your-robinhood-rpc-url-here
